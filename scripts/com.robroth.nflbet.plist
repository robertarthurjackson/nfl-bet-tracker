<?xml version="1.0" encoding="UTF-8"?>
<!-- Always-on on the Mac:
     cp scripts/com.robroth.nflbet.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.robroth.nflbet.plist
     (unload with launchctl unload ...). Logs: api/data/nflbet.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.robroth.nflbet</string>
  <key>ProgramArguments</key><array>
    <string>/Users/RobRoth/projects/betting/api/.venv/bin/uvicorn</string>
    <string>nflbet.main:app</string><string>--host</string><string>0.0.0.0</string><string>--port</string><string>8000</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/RobRoth/projects/betting/api</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/RobRoth/projects/betting/api/data/nflbet.log</string>
  <key>StandardErrorPath</key><string>/Users/RobRoth/projects/betting/api/data/nflbet.log</string>
</dict></plist>
